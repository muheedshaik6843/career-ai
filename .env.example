# Root Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# BACKEND SETTINGS
# ============================================
# Security (REQUIRED for production - generate a secure 32+ char key)
SECRET_KEY=your-super-secret-jwt-key-min-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=career_ai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS - comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Provider (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Environment
ENVIRONMENT=development

# ============================================
# FRONTEND SETTINGS
# ============================================
# Backend API URL (your deployed Render backend URL)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id