# ============================================================
# AI Career Assistant – Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to version control
# ============================================================

# ─── Backend ────────────────────────────────────────────────
# JWT
SECRET_KEY=your_super_secret_key_minimum_32_characters_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=career_ai
# OR override with full DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host:5432/career_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# App Environment
ENVIRONMENT=development

# ─── AI Provider (Phase 2+) ─────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your_openai_api_key_here
AI_PROVIDER=gemini

# ─── Storage (Phase 2+) ─────────────────────────────────────
# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=career-ai-resumes
AWS_REGION=us-east-1
# OR Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── OAuth (Optional) ────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ─── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=AI Career Assistant
NEXT_PUBLIC_APP_URL=http://localhost:3000
